# Sao chép thành .env, điền thông tin từ Project settings của dự án MỚI.
# Firebase client config; không dùng khóa service account.
FIREBASE_PROJECT_ID=THAY_PROJECT_ID_MOI
FIREBASE_MESSAGING_SENDER_ID=THAY_PROJECT_NUMBER
FIREBASE_AUTH_DOMAIN=THAY_PROJECT_ID_MOI.firebaseapp.com
FIREBASE_WEB_API_KEY=THAY_API_KEY_WEB
FIREBASE_WEB_APP_ID=THAY_APP_ID_WEB
FIREBASE_ANDROID_API_KEY=THAY_API_KEY_ANDROID
FIREBASE_ANDROID_APP_ID=THAY_APP_ID_ANDROID
