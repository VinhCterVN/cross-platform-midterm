rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function manager() {
      // Thay bằng UID tài khoản quản lý từ Authentication của DỰ ÁN MỚI.
      return signedIn() && request.auth.uid in ['oK4Pt2NE7iO7gHNwmvu41EDb2mh1'];
    }
    function owns(ownerId) { return signedIn() && request.auth.uid == ownerId; }
    function validProduct() {
      let p = request.resource.data;
      return p.keys().hasAll(['name', 'price', 'soluong', 'image'])
        && p.keys().hasOnly(['name', 'price', 'soluong', 'image'])
        && p.name is string && p.name.size() > 0 && p.name.size() <= 120
        && p.name.matches('.*[^\\s].*')
        && p.price is number && p.price >= 0 && p.price <= 1000000000000
        && p.soluong is int && p.soluong >= 0 && p.soluong <= 1000000000
        && p.image is string && p.image.size() > 0 && p.image.size() <= 273068
        && p.image.matches('^[A-Za-z0-9+/]+={0,2}$')
        && (p.image.matches('^iVBORw0KGgo.*') || p.image.matches('^/9j/.*'));
    }
    match /owners/{ownerId}/products/{productId} {
      allow read: if owns(ownerId) || manager();
      allow create, update: if (owns(ownerId) || manager()) && validProduct();
      allow delete: if owns(ownerId) || manager();
    }
    // Collection group cần rule v2 riêng. Chỉ mở quyền đọc cho quản lý.
    match /{path=**}/products/{productId} {
      allow read: if manager();
    }
    // Không cấp quyền ghi document owners, users hoặc collection khác.
  }
}
