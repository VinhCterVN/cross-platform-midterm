rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminUid(uid) {
      // Thay bằng UID từ Authentication Console, không dùng email/khóa bí mật.
      return uid in ['EI6g1w5pDtNvxJw2baBxUUMiyti2'];
    }
    function isAdmin() {
      return request.auth != null && adminUid(request.auth.uid);
    }
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validHash(value) {
      // Rules chỉ xác minh định dạng, không thể đối chiếu mật khẩu với Firebase Auth.
      return value is string && value.size() == 90 &&
        value.matches('^pbkdf2-sha256[$]600000[$][A-Za-z0-9+/]{22}==[$][A-Za-z0-9+/]{43}=$');
    }
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasAll(['email', 'matkhau', 'hoten', 'hinhanh']) &&
        d.keys().hasOnly(['email', 'matkhau', 'hoten', 'hinhanh']) &&
        d.email is string && d.email.size() <= 254 &&
        d.email == d.email.lower() &&
        d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
        d.matkhau is string &&
        (validHash(d.matkhau) ||
          d.matkhau == 'Được quản lý bởi Firebase Authentication') &&
        d.hoten is string && d.hoten.size() >= 1 && d.hoten.size() <= 100 &&
        d.hoten.matches('.*\\S.*') &&
        d.hinhanh is string && d.hinhanh.size() >= 12 &&
        d.hinhanh.size() <= 273068 && d.hinhanh.size() % 4 == 0 &&
        d.hinhanh.matches('^[A-Za-z0-9+/]+={0,2}$') &&
        (d.hinhanh.matches('^iVBORw0KGgo[A-Za-z0-9+/]*={0,2}$') ||
         d.hinhanh.matches('^/9j/[A-Za-z0-9+/]*={0,2}$'));
    }
    match /users/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if validProfile() && validHash(request.resource.data.matkhau) && (isAdmin() ||
        (owner(uid) && request.resource.data.email == request.auth.token.email.lower()));
      allow update: if validProfile() && (
        ((owner(uid) || isAdmin()) && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['hoten', 'hinhanh'])) ||
        (owner(uid) && validHash(request.resource.data.matkhau) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matkhau']))
      );
      // Xóa hồ sơ không thu hồi Auth. Người dùng vẫn có thể tạo lại hồ sơ của mình.
      allow delete: if isAdmin() && !adminUid(uid);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
